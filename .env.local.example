# 复制为 .env.local（不入库）后按需填写；make 会读取它。CI 不读，始终用模拟服务。
# 工具容器与运行环境所在的 Docker 上下文：不设就用本机 Docker；远端主机先 docker context create 再填名字
DOCKER_CONTEXT=
# 访问不了官方源时的镜像（不设就用官方源）
BF_GOPROXY=
BF_PIP_INDEX_URL=
BF_DEBIAN_MIRROR=
BF_NPM_REGISTRY=
# 用真实的嵌入、精排、NLI 模型（首次启动下载约 6 GB；切换前先 make down VOLUMES=1）
BF_MODELS=1
# 选作线上校验器的 NLI 候选（tools/model-server/models.json）
BF_NLI_DEFAULT=nli-erlangshen-110m
# 外部 LLM（OpenAI 兼容端点）。密钥只在这里，经 compose secret 以文件注入 orchestrator，不进仓库与日志
BF_LLM_URL=https://api.example.com
BF_LLM_MODEL=
BF_LLM_API_KEY=
# 厂商专有的请求参数（JSON）。推理型模型必须关闭思考，否则 800 token 的输出上限会被思考过程用完、正文为空
BF_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 运行环境放到 GPU 主机（工具容器与 make check 仍在 DOCKER_CONTEXT 指定的主机），模型服务用 CUDA
BF_STACK_CONTEXT=
BF_MODELS_GPU=1
