{
  "uid": "bambuflow-rag",
  "title": "RAG 概览",
  "tags": [
    "bambuflow"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(orchestrator_answers_total, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(orchestrator_answers_total, tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "回答",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "回答数（每分钟，按状态）",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(orchestrator_answers_total{tenant=~\"$tenant\"}[5m])) * 60",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "端到端 p95（按意图）",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (intent, le) (rate(orchestrator_answer_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "{{intent}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orchestrator_answer_first_sentence_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "第一句"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "引用覆盖率中位数",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(orchestrator_answer_coverage_bucket{tenant=~\"$tenant\"}[15m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "丢句（每分钟，按原因）",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(orchestrator_sentences_dropped_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "降级（每分钟，按环节）",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, reason) (rate(orchestrator_degraded_total[5m])) * 60",
          "legendFormat": "{{stage}} {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "token（每分钟，按模型与方向）",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (rate(orchestrator_tokens_total{tenant=~\"$tenant\"}[5m])) * 60",
          "legendFormat": "{{model}} {{direction}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "安全事件（应为 0）",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(orchestrator_security_total[1h]))",
          "legendFormat": "{{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(retrieval_assemble_dropped_total[1h]))",
          "legendFormat": "组装阶段二次过滤"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "检索",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "各路召回 p95",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(retrieval_route_duration_seconds_bucket{outcome=\"ok\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "各路召回的结果（每分钟）",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, outcome) (rate(retrieval_route_duration_seconds_count[5m])) * 60",
          "legendFormat": "{{route}} {{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "缓存命中率（按层）",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (layer) (rate(retrieval_cache_lookups_total{result=\"hit\"}[15m])) / sum by (layer) (rate(retrieval_cache_lookups_total[15m]))",
          "legendFormat": "{{layer}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "每次检索各路返回的候选数",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(retrieval_route_results_total[5m])) / sum by (route) (rate(retrieval_route_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "入库",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "变更到可检索 p95（按数据源）",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (source, le) (rate(ingest_freshness_seconds_bucket[30m])))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "撤权与删除到生效 p95",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (kind, le) (rate(indexing_access_lag_seconds_bucket[15m])))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "处理结果与死信（每小时）",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(ingest_documents_total[1h]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(ingest_dead_letters_total[1h]))",
          "legendFormat": "死信"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "向量缓存命中率",
      "gridPos": {
        "x": 8,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_vector_cache_total{result=\"hit\"}[1h])) / sum(rate(ingest_vector_cache_total[1h]))",
          "legendFormat": "命中率"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "连接器连续失败轮数",
      "gridPos": {
        "x": 16,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "connectors_sync_consecutive_failures",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "质量",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "在线抽样 Groundedness 与引用精确率",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evaluation_online_groundedness{tenant=~\"$tenant\"}",
          "legendFormat": "{{tenant}} Groundedness"
        },
        {
          "refId": "B",
          "expr": "evaluation_online_citation_precision{tenant=~\"$tenant\"}",
          "legendFormat": "{{tenant}} 引用精确率"
        }
      ]
    },
    {
      "id": 22,
      "type": "row",
      "title": "元数据库",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "权限读取（每分钟，按结果）",
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(retrieval_permission_reads_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "权限读副本落后于撤权位点",
      "gridPos": {
        "x": 12,
        "y": 69,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (replica) (retrieval_permission_replica_lag_bytes)",
          "legendFormat": "{{replica}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "权限复核 p99 与单条撤权 p95",
      "gridPos": {
        "x": 0,
        "y": 77,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(retrieval_permission_duration_seconds_bucket[5m])))",
          "legendFormat": "权限复核 p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(indexing_revocation_duration_seconds_bucket[5m])))",
          "legendFormat": "单条撤权 p95"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "待生效撤权名单",
      "gridPos": {
        "x": 12,
        "y": 77,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(indexing_revocation_pending)",
          "legendFormat": "条目数"
        },
        {
          "refId": "B",
          "expr": "max(indexing_revocation_pending_oldest_seconds)",
          "legendFormat": "最老条目（秒）"
        }
      ]
    }
  ]
}
