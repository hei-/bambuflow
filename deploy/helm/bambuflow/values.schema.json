{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bambuflow values",
  "description": "环境相关的值必须显式给出；测试 realm、开发口令、模拟服务和本地地址不能出现在部署用的 values 里。",
  "type": "object",
  "definitions": {
    "noDev": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "dev-only"}},
        {"not": {"pattern": "[Mm][Oo][Cc][Kk]"}}
      ]
    },
    "url": {
      "allOf": [
        {"$ref": "#/definitions/noDev"},
        {"pattern": "^https?://[^/]+"},
        {"not": {"pattern": "/realms/corp-idp"}},
        {"not": {"pattern": "^https?://(keycloak|localhost|127\\.0\\.0\\.1|llm|nli|embedder)(:|/|$)"}}
      ]
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object"},
        "limits": {"type": "object"}
      }
    },
    "redisAddr": {"allOf": [{"$ref": "#/definitions/noDev"}, {"pattern": "^[^/:]+:[0-9]+$"}, {"not": {"pattern": "^(redis|localhost|127\\.0\\.0\\.1):"}}]},
    "replicas": {"type": "integer", "minimum": 2, "description": "HPA 下限；至少 2 个，PDB 才能在驱逐时保住一个"},
    "maxReplicas": {"type": "integer", "minimum": 2}
  },
  "required": ["image", "vault", "networkPolicy", "otel", "events", "revocation", "tenants", "policyLayers", "indexing", "processingAdmin", "connectorsAdmin", "gateway", "retrieval", "governance", "orchestrator", "batch", "evaluation", "evalReplicas", "webhook", "identitySync"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["registry", "tag", "pullPolicy"],
      "properties": {
        "registry": {"$ref": "#/definitions/noDev"},
        "tag": {"$ref": "#/definitions/noDev"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent"]}
      }
    },
    "vault": {
      "type": "object",
      "required": ["addr", "role", "webhookRole", "gatewayRole", "kvMount", "authMount"],
      "properties": {
        "addr": {"$ref": "#/definitions/url"},
        "role": {"$ref": "#/definitions/noDev"},
        "webhookRole": {"$ref": "#/definitions/noDev"},
        "gatewayRole": {"$ref": "#/definitions/noDev"},
        "kvMount": {"type": "string", "minLength": 1},
        "authMount": {"type": "string", "minLength": 1}
      }
    },
    "tenants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["rollout", "member_groups"],
        "properties": {
          "rollout": {"enum": ["pilot", "general"]},
          "member_groups": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "pilot_groups": {"type": "array", "items": {"type": "string"}},
          "auditor_groups": {"type": "array", "items": {"type": "string"}},
          "owner_groups": {"type": "array", "items": {"type": "string"}},
          "bound_clients": {"type": "array", "items": {"type": "string"}},
          "mcp_agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["client_id", "purpose", "owner"],
              "additionalProperties": false,
              "properties": {
                "client_id": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "owner": {"type": "string", "minLength": 1},
                "rps": {"type": "integer", "minimum": 1}
              }
            }
          },
          "mcp_tools": {
            "type": "array",
            "items": {"enum": ["ask", "search_documents", "list_documents", "count_documents", "get_document_excerpt"]}
          },
          "quota": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_concurrency": {"type": "integer", "minimum": 1},
              "daily_tokens": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "policyLayers": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^(tenant\\.[a-z0-9-]{1,64}|source\\.[a-z0-9_-]{1,64})$": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["ingressNamespace", "monitoringNamespace", "ingestNamespace"],
      "properties": {
        "ingressNamespace": {"type": "string", "minLength": 1},
        "monitoringNamespace": {"type": "string", "minLength": 1},
        "ingestNamespace": {"type": "string", "minLength": 1}
      }
    },
    "otel": {
      "type": "object",
      "required": ["endpoint"],
      "properties": {"endpoint": {"$ref": "#/definitions/url"}}
    },
    "events": {
      "type": "object",
      "required": ["redisAddr"],
      "properties": {"redisAddr": {"$ref": "#/definitions/redisAddr"}}
    },
    "revocation": {
      "type": "object",
      "required": ["redisAddr"],
      "properties": {"redisAddr": {"$ref": "#/definitions/redisAddr"}}
    },
    "indexing": {
      "type": "object",
      "required": ["addr"],
      "properties": {
        "addr": {"allOf": [{"$ref": "#/definitions/noDev"}, {"pattern": "^[^/:]+:[0-9]+$"}, {"not": {"pattern": "^(indexing|localhost|127\\.0\\.0\\.1):"}}]}
      }
    },
    "connectorsAdmin": {
      "type": "object",
      "required": ["addr"],
      "properties": {
        "addr": {"allOf": [{"$ref": "#/definitions/noDev"}, {"pattern": "^[^/:]+:[0-9]+$"}, {"not": {"pattern": "^(connectors-admin|localhost|127\\.0\\.0\\.1):"}}]}
      }
    },
    "processingAdmin": {
      "type": "object",
      "required": ["addr"],
      "properties": {
        "addr": {"allOf": [{"$ref": "#/definitions/noDev"}, {"pattern": "^[^/:]+:[0-9]+$"}, {"not": {"pattern": "^(processing-admin|localhost|127\\.0\\.0\\.1):"}}]}
      }
    },
    "gateway": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "publicUrl", "platformIssuer", "platformClients", "redisAddr", "userStreams", "quotaTimezone", "adminRoles", "stepUp", "clientCertHeader", "signingKeyRotateEvery", "audit", "resources"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "publicUrl": {"allOf": [{"$ref": "#/definitions/url"}, {"pattern": "^https://[^/]+$"}]},
        "platformIssuer": {"allOf": [{"$ref": "#/definitions/url"}, {"pattern": "/realms/[^/]+$"}]},
        "platformClients": {"type": "string", "minLength": 1},
        "redisAddr": {"$ref": "#/definitions/redisAddr"},
        "userStreams": {"type": "integer", "minimum": 1},
        "quotaTimezone": {"type": "string", "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Za-z0-9_+-]+)+)$"},
        "stepUp": {
          "type": "object",
          "required": ["acrValues", "maxAge"],
          "properties": {
            "acrValues": {"type": "string", "pattern": "^[^,\\s]+(,[^,\\s]+)*$"},
            "maxAge": {"type": "string", "pattern": "^[0-9]+(s|m)$"}
          }
        },
        "clientCertHeader": {"type": "string", "pattern": "^([A-Za-z0-9-]+)?$"},
        "signingKeyRotateEvery": {"type": "string", "pattern": "^[0-9]+h$"},
        "adminRoles": {
          "type": "object",
          "propertyNames": {"enum": ["platform_admin", "platform_operator", "infosec", "data_owner", "auditor", "llm_debugger"]},
          "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "audit": {
          "type": "object",
          "required": ["s3Endpoint", "bucket", "retentionDays", "storageSize"],
          "properties": {
            "s3Endpoint": {"allOf": [{"$ref": "#/definitions/url"}, {"not": {"pattern": "^https?://rustfs(:|/|$)"}}]},
            "bucket": {"type": "string", "minLength": 3},
            "retentionDays": {"type": "integer", "minimum": 365},
            "storageSize": {"type": "string", "pattern": "^[0-9]+[GT]i$"}
          }
        },
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "retrieval": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "embedderUrl", "resources"],
      "properties": {
        "emergencyDenials": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9_-]{1,64}$"}, "additionalProperties": {"type": "string", "minLength": 1}},
        "cacheRedisAddr": {"type": "string", "pattern": "^([^/:]+:[0-9]+)?$"},
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "embedderUrl": {"$ref": "#/definitions/url"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "governance": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "resources", "gitForge"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "resources": {"$ref": "#/definitions/resources"},
        "gitForge": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["", "gitlab"]},
            "gitlabUrl": {"type": "string"},
            "gitlabProject": {"type": "string"},
            "targetBranch": {"type": "string", "minLength": 1}
          },
          "if": {"properties": {"kind": {"const": "gitlab"}}},
          "then": {"required": ["gitlabUrl", "gitlabProject", "targetBranch"],
                   "properties": {"gitlabUrl": {"$ref": "#/definitions/url"}, "gitlabProject": {"minLength": 1}}}
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "llmUrl", "llmModel", "nliUrl", "redisAddr", "maxConcurrency", "resources"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "llmUrl": {"$ref": "#/definitions/url"},
        "llmModel": {"$ref": "#/definitions/noDev"},
        "llmKind": {"enum": ["private", "external"]},
        "llmRestrictedUrl": {"type": "string"},
        "llmRestrictedModel": {"type": "string"},
        "llmAltModels": {"type": "string"},
        "nliUrl": {"$ref": "#/definitions/url"},
        "redisAddr": {"$ref": "#/definitions/redisAddr"},
        "maxConcurrency": {"type": "integer", "minimum": 1},
        "answerRetentionDays": {"type": "integer", "minimum": 0},
        "purgeSchedule": {"type": "string"},
        "sqlCatalog": {
          "type": "object",
          "properties": {
            "tenants": {"type": "array", "items": {"type": "string"}},
            "roles": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
            "views": {"type": "array", "items": {"type": "object", "required": ["name", "columns"]}}
          }
        },
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "batch": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "resources"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "evalReplicas": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1, "description": "只接评测流量，不要求高可用"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "guardSchedule", "observeSchedule", "onlineSchedule", "onlineTenants", "nliUrl", "judgeModel", "resources"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "guardSchedule": {"type": "string", "minLength": 9},
        "observeSchedule": {"type": "string", "minLength": 9},
        "onlineSchedule": {"type": "string", "minLength": 9},
        "onlineTenants": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}},
        "nliUrl": {"type": "string"},
        "judgeModel": {"type": "string"},
        "llmJudgeUrl": {"type": "string"},
        "llmJudgeModel": {"type": "string"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "webhook": {
      "type": "object",
      "required": ["replicas", "maxReplicas", "resources"],
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "maxReplicas": {"$ref": "#/definitions/maxReplicas"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "identitySync": {
      "type": "object",
      "required": ["config", "exportClaim", "exportMountPath", "resources"],
      "properties": {
        "config": {
          "type": "object",
          "required": ["source", "mapping", "interval"],
          "oneOf": [{"required": ["ldap"]}, {"required": ["scim"]}, {"required": ["file"]}],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "ldap": {"type": "object", "properties": {"url": {"allOf": [{"type": "string", "pattern": "^ldaps?://"}, {"not": {"pattern": "^ldaps?://(openldap|localhost|127\\.0\\.0\\.1)(:|/|$)"}}]}}},
            "scim": {"type": "object", "required": ["listen", "token_env"], "properties": {"listen": {"type": "string", "pattern": "^:[0-9]+$"}}},
            "file": {"type": "object", "required": ["path"]}
          }
        },
        "exportClaim": {"type": "string"},
        "exportMountPath": {"type": "string", "pattern": "^/"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    }
  }
}
