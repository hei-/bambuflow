# PyMuPDF 的类型存根，只覆盖仓库用到的接口（共享盘样例生成器、e2e，都只在开发与 CI 里用）。
# processing 不再用 PyMuPDF（AGPL），PDF 改用 pypdfium2 与 pdfplumber。
# PyMuPDF 自带的注解不完整（多数函数没有标注，mypy 严格模式下逐个报错）；PyPI 上的 pymupdf-stubs
# 缺 Font、insert_font、Document 迭代等接口。用到新接口时在这里补上，签名以 PyMuPDF 文档为准。
from collections.abc import Iterator, Sequence
from os import PathLike
from types import TracebackType
from typing import Any, Literal, overload

class FileDataError(RuntimeError): ...
class Colorspace: ...

csGRAY: Colorspace
csRGB: Colorspace

class Matrix:
    def __init__(self, a: float, d: float) -> None: ...

class Rect:
    x0: float
    y0: float
    x1: float
    y1: float
    width: float
    height: float
    @overload
    def __init__(self, x0: float, y0: float, x1: float, y1: float) -> None: ...
    @overload
    def __init__(self, rect: Sequence[float] | Rect) -> None: ...
    def __iter__(self) -> Iterator[float]: ...
    def __add__(self, other: Sequence[float] | Rect) -> Rect: ...

class Pixmap:
    width: int
    height: int
    def __init__(self, data: bytes) -> None: ...
    def tobytes(self, output: str = "png", jpg_quality: int = 95) -> bytes: ...
    def save(self, filename: str | PathLike[str], output: str | None = None) -> None: ...

class Font:
    buffer: bytes
    def __init__(self, fontname: str) -> None: ...
    def text_length(self, text: str, fontsize: float = 11) -> float: ...

class TableRow:
    bbox: tuple[float, float, float, float]

class Table:
    bbox: tuple[float, float, float, float]
    rows: list[TableRow]
    def extract(self) -> list[list[str | None]]: ...

class TableFinder:
    tables: list[Table]

class Page:
    number: int
    rect: Rect
    @overload
    def get_text(
        self, option: Literal["text"] = "text", *, clip: Rect | None = None, sort: bool = False
    ) -> str: ...
    @overload
    def get_text(
        self, option: Literal["dict"], *, clip: Rect | None = None, sort: bool = False
    ) -> dict[str, Any]: ...
    def get_images(self) -> list[tuple[Any, ...]]: ...
    def get_pixmap(
        self,
        *,
        matrix: Matrix | None = None,
        dpi: int | None = None,
        colorspace: Colorspace | None = None,
    ) -> Pixmap: ...
    def find_tables(self) -> TableFinder: ...
    def insert_font(self, fontname: str, fontbuffer: bytes) -> int: ...
    def insert_text(
        self, point: tuple[float, float], text: str, *, fontname: str, fontsize: float
    ) -> int: ...
    def draw_rect(self, rect: Rect, *, color: tuple[float, float, float], width: float) -> None: ...
    def insert_image(self, rect: Rect, *, stream: bytes) -> int: ...

class Document:
    needs_pass: bool
    def __enter__(self) -> Document: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...
    def __iter__(self) -> Iterator[Page]: ...
    def __getitem__(self, index: int) -> Page: ...
    def __len__(self) -> int: ...
    def new_page(self, *, width: float, height: float) -> Page: ...
    def set_metadata(self, metadata: dict[str, str]) -> None: ...
    def subset_fonts(self) -> None: ...
    def save(
        self,
        filename: str | PathLike[str],
        *,
        garbage: int = 0,
        deflate: bool = False,
        no_new_id: bool = False,
    ) -> None: ...

@overload
def open() -> Document: ...
@overload
def open(filename: str | PathLike[str]) -> Document: ...
@overload
def open(*, stream: bytes, filetype: str) -> Document: ...
