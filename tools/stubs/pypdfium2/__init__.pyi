# pypdfium2 的类型存根，只覆盖仓库用到的接口（processing 的 PDF 解析）。pypdfium2 没有 py.typed，
# PyPI 上也没有存根包。用到新接口时在这里补上，签名以 pypdfium2 文档为准。
from collections.abc import Iterator

from PIL import Image

class PdfiumError(RuntimeError):
    err_code: int | None

class PdfBitmap:
    def to_pil(self) -> Image.Image: ...

class PdfObject:
    # (left, bottom, right, top)，PDF 坐标（原点在左下角）
    def get_bounds(self) -> tuple[float, float, float, float]: ...

class PdfImage(PdfObject):
    def get_px_size(self) -> tuple[int, int]: ...
    def get_bitmap(self, render: bool = False) -> PdfBitmap: ...

class PdfTextPage:
    def get_text_range(self, index: int = 0, count: int = -1) -> str: ...
    def close(self) -> None: ...

class PdfPage:
    def get_height(self) -> float: ...
    def get_textpage(self) -> PdfTextPage: ...
    def get_objects(
        self, filter: tuple[int, ...] | None = None, max_depth: int = 15
    ) -> Iterator[PdfObject]: ...
    def render(self, scale: float = 1) -> PdfBitmap: ...

class PdfDocument:
    def __init__(
        self, input: bytes, password: str | None = None, autoclose: bool = False
    ) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> PdfPage: ...
    def close(self) -> None: ...
