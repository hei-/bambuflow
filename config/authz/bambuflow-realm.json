{
  "realm": "bambuflow",
  "displayName": "bambuflow 平台授权服务",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "defaultSignatureAlgorithm": "ES256",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "ecdsa-p256",
        "providerId": "ecdsa-generated",
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "ecdsaEllipticCurveKey": ["P-256"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "console",
      "name": "管理控制台",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${CONSOLE_REDIRECT_URI}"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.signed.response.alg": "ES256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bambuflow-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "corp-idp",
      "displayName": "公司账号",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "${CORP_IDP_ISSUER}",
        "authorizationUrl": "${CORP_IDP_ISSUER}/protocol/openid-connect/auth",
        "tokenUrl": "${CORP_IDP_ISSUER}/protocol/openid-connect/token",
        "jwksUrl": "${CORP_IDP_ISSUER}/protocol/openid-connect/certs",
        "userInfoUrl": "${CORP_IDP_ISSUER}/protocol/openid-connect/userinfo",
        "logoutUrl": "${CORP_IDP_ISSUER}/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "${CORP_IDP_CLIENT_ID}",
        "clientSecret": "${CORP_IDP_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "FORCE"
      }
    }
  ]
}
